{
  "name": "stock-portfolio-tracker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node hosted/scripts/build.mjs",
    "check": "tsc --noEmit -p hosted/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "dev": "node hosted/scripts/dev.mjs",
    "test": "node --import tsx --test hosted/tests/*.test.ts",
    "db:generate": "drizzle-kit generate --config hosted/drizzle.config.ts"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "jose": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "zod": "^3.25.0",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.27.0",
    "drizzle-kit": "^0.31.8",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.3",
    "tsx": "^4.22.0"
  }
}
